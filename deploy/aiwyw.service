[Unit]
Description=WeiYunWan Spring Boot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aiwyw
Group=aiwyw
WorkingDirectory=/opt/aiwyw/current
EnvironmentFile=-/opt/aiwyw/current/config/jvm.env
ExecStart=/usr/bin/java $JAVA_OPTS -Dloader.path=lib -jar aiwyw-server.jar --spring.config.additional-location=file:./config/
Restart=on-failure
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
