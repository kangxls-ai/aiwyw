{
  "name": "aiwyw",
  "private": true,
  "workspaces": [
    "web"
  ],
  "overrides": {
    "glob@13.0.6": "14.0.4",
    "minimatch@10.2.6": "11.0.5"
  },
  "scripts": {
    "dev": "npm run dev --workspace web",
    "start": "node scripts/start-local.mjs",
    "build": "npm run build --workspace web",
    "typecheck": "npm run typecheck --workspace web",
    "test:e2e": "playwright test",
    "deploy:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-local.ps1",
    "stop:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "open:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-managed-local.ps1",
    "build:static": "node scripts/build-static.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.3.3",
    "smtp-server": "3.21.3"
  }
}
